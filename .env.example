# Telegram bot tokeni (@BotFather). Lokal sinov uchun ALOHIDA test bot tokenini ishlating.
BOT_TOKEN=

# Adminlar Telegram ID lari, vergul bilan: 11111,22222
ADMIN_IDS=

# Har bir arizaning nusxasi boradigan chat: admin ID si yoki guruh ID si (-100...)
ADMIN_CHAT_ID=

# Sotuv menejerlari ID lari, vergul bilan (arizalar navbat bilan taqsimlanadi)
MANAGER_IDS=

# SQLite baza yo'li. Railway'da: /app/data/bot.db
DB_PATH=data/bot.db
